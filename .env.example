# Local non-secret configuration
RISK_MAX_ORDER_PERCENT=10
RISK_MAX_STOCK_ALLOCATION_PERCENT=20
RISK_MAX_LOSS_PER_TRADE_PERCENT=1
RISK_MAX_DAILY_LOSS_PERCENT=2
RISK_DAILY_LOSS_TIMEZONE=Asia/Kolkata

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Copy this file to .env, set AUTH_TOKEN, then run: chmod 600 .env
AUTH_TOKEN=
AUTH_DISABLED=false
BACKEND_HOST=127.0.0.1

# Local SQLite backups (financial records; never commit this directory)
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_COUNT=10
